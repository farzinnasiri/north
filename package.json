{
  "name": "north",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/metro-runtime": "~58.0.17",
    "expo": "~58.0.26",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-media-library": "~58.0.14",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@google/design.md": "^0.4.0",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-plugin-jest": "^29.16.0",
    "expo-atlas": "^0.4.3",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "typescript": "~6.0.3",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "tokens": "node scripts/tokens.mts",
    "design:lint": "designmd lint DESIGN.md",
    "expo:go": "EXPO_NO_DOTENV=1 NORTH_APP_VARIANT=development EXPO_PUBLIC_APP_ENV=development pnpm exec expo start --go --lan",
    "expo:dev": "EXPO_NO_DOTENV=1 NORTH_APP_VARIANT=development EXPO_PUBLIC_APP_ENV=development pnpm exec expo start --dev-client --lan",
    "expo:dev:clean": "EXPO_NO_DOTENV=1 NORTH_APP_VARIANT=development EXPO_PUBLIC_APP_ENV=development pnpm exec expo start --dev-client --lan --clear",
    "ios:dev-client": "rnd build --platform ios --profile development",
    "ios:dev-sim": "rnd build --platform ios --profile development-simulator",
    "ios:preview": "rnd build --platform ios --profile preview",
    "android:dev-client": "rnd build --platform android --profile development",
    "ios:device-register": "rnd device:create",
    "ios:testflight:check": "node scripts/check-ios-submission.mjs",
    "ios:testflight:build": "node scripts/check-ios-submission.mjs && rnd build --platform ios --profile testflight",
    "ios:testflight": "make ios-testflight",
    "ios:testflight:status": "node scripts/check-ios-submission.mjs && rnd submit:status --platform ios --profile testflight",
    "ios:app-link": "node scripts/link-ios-app.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "<rootDir>/jest.resolver.js",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/content-api/"
    ],
    "setupFiles": [
      "react-native-gesture-handler/jestSetup.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/app/**"
    ]
  },
  "private": true,
  "packageManager": "pnpm@12.16.1"
}
