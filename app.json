{
  "expo": {
    "name": "North",
    "slug": "north",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "north",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      },
      "supportsTablet": false
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#090B0C",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090B0C",
          "image": "./assets/splash-mark.png",
          "imageWidth": 168,
          "resizeMode": "contain"
        }
      ],
      "expo-audio",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/barlow-condensed/600SemiBold/BarlowCondensed_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/barlow-condensed/700Bold/BarlowCondensed_700Bold.ttf",
            "node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
            "node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf",
            "node_modules/@expo-google-fonts/jetbrains-mono/400Regular/JetBrainsMono_400Regular.ttf",
            "node_modules/@expo-google-fonts/jetbrains-mono/500Medium/JetBrainsMono_500Medium.ttf"
          ]
        }
      ],
      "expo-asset",
      "expo-sqlite",
      "expo-image",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Allow North to save your Reality card to Photos.",
          "granularPermissions": [
            "photo"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
